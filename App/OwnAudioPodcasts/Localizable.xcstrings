    "Shows on this iPhone stay; they are no longer kept in step.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pořady v tomto iPhonu zůstanou, jen se už nebudou synchronizovat."
          }
        }
      }
    },
    "Shows you follow on this iPhone need no server. A server adds its own shows; a gPodder account keeps this iPhone's in step with your other players.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pořady odebírané v tomto iPhonu žádný server nepotřebují. Server přidá své vlastní pořady, účet gPodder udržuje pořady tohoto iPhonu ve shodě s ostatními přehrávači."
          }
        }
      }
    },
