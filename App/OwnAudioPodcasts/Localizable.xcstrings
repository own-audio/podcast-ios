    "An invitation is a code for one person. They sign in to this server and enter it, or open its link." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozvánka je kód pro jednoho člověka. Přihlásí se k tomuto serveru a zadá ho, nebo otevře její odkaz."
          }
        }
      }
    },
    "Another device got to %@; this iPhone was at %@." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jiné zařízení došlo na %@, tento iPhone byl na %@."
          }
        }
      }
    },
    "Answers come from the episode's transcript only, and each one is paid from your family's credit. Your questions are kept for you alone." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpovědi vycházejí jen z přepisu epizody a každá se platí z kreditu vaší rodiny. Vaše otázky vidíte jen vy."
          }
        }
      }
    },
    "Apple didn't return a sign-in. Try again." : {
