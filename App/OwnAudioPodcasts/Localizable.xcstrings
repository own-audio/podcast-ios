    },
    "A gPodder sync account (podfetch, gpodder.net, an own.audio server): this iPhone's shows and positions are kept in step with your other players." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Účet synchronizace gPodder (podfetch, gpodder.net, server own.audio): pořady a pozice v tomto iPhonu se udržují ve shodě s ostatními přehrávači."
          }
        }
      }
    },
    "A Month at Today's Storage" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Měsíc při dnešním úložišti"
          }
        }
      }
    },
    "A shared own.audio server with sample shows, to look around without an account." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sdílený server own.audio s ukázkovými pořady, abyste se mohli rozhlédnout bez účtu."
          }
        }
      }
    },
    "A show's RSS feed" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RSS kanál pořadu"
          }
        }
      }
    },
    "A summary is made from the transcript with AI and paid from your family's credit, usually a cent or two. Everyone in the family can then read it." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shrnutí se vytvoří z přepisu pomocí AI a zaplatí z kreditu vaší rodiny, obvykle méně než korunu. Pak si ho může přečíst celá rodina."
          }
        }
      }
    },
