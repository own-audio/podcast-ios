            "value" : "Vaše epizody"
          }
        }
      }
    },
    "Your own.audio account: its shows, New Episodes and positions on every device." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš účet own.audio: jeho pořady, nové epizody a pozice na každém zařízení."
          }
        }
      }
    },
    "Your podcasts. No account, no server needed." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše podcasty. Bez účtu, bez serveru."
          }
        }
      }
    },
