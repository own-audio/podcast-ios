    },
    "What its members share appears instead of what this family shares." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Místo toho, co sdílí tato rodina, uvidíte, co sdílejí členové té druhé."
          }
        }
      }
    },
    "Who is in the family, its storage and credit, invitations; and every device signed in to this account." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kdo je v rodině, její úložiště a kredit, pozvánky; a každé zařízení přihlášené k tomuto účtu."
          }
        }
      }
    },
    "With a code from that family's admin. You then leave this one." : {
      "localizations" : {
