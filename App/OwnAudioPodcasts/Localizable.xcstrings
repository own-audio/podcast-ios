      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento iPhone"
          }
        }
      }
    },
    "This iPhone's shows and positions are kept in step with the account, as every other app signed in to it does.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pořady a pozice v tomto iPhonu se udržují ve shodě s účtem, stejně jako v každé další aplikaci, která je k němu přihlášená."
          }
        }
      }
    },
