    "A gPodder sync account (podfetch, gpodder.net, an own.audio server): this iPhone's shows and positions are kept in step with your other players.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Účet synchronizace gPodder (podfetch, gpodder.net, server own.audio): pořady a pozice v tomto iPhonu se udržují ve shodě s ostatními přehrávači."
          }
        }
      }
    },
    "A shared own.audio server with sample shows, to look around without an account.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sdílený server own.audio s ukázkovými pořady, abyste se mohli rozhlédnout bez účtu."
          }
        }
      }
    },
