    "Add episodes with Play Next or Play Later from their menu." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Epizody přidáte z jejich nabídky volbou Přehrát jako další nebo Přehrát později."
          }
        }
      }
    },
    "Add New Episodes to Up Next" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidávat nové epizody do fronty"
          }
        }
      }
    },
    "Add the server's address on your home network, a VPN such as Tailscale, or a second public name. On each network the app uses the fastest one that answers." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidejte adresu serveru v domácí síti, ve VPN jako Tailscale nebo druhé veřejné jméno. V každé síti aplikace použije tu nejrychlejší, která odpovídá."
          }
        }
      }
    },
